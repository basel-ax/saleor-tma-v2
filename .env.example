# Cloudflare API Token for Wrangler CLI deployment
# Get your token from: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Account → Cloudflare Pages → Edit
CLOUDFLARE_API_TOKEN=your_token_here

# Optional: Cloudflare Account ID (found in your dashboard URL or Workers overview)
# Format: 32-character hex string (e.g., 408ba415d22630d63af575e11c8d3088)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Saleor configuration (for build-time)
VITE_SALEOR_API_URL=https://demo.saleor.io/graphql/
VITE_SALEOR_CHANNEL=default-channel
VITE_SALEOR_DOCS_URL=https://docs.saleor.io
